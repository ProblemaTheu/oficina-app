    {
      "name": "Peças",
      "description": "Catálogo e controle de estoque de peças e insumos.",
      "item": [
        {
          "name": "Listar peças",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/parts?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["parts"],
              "query": [
