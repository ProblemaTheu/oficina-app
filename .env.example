# Copie para `.env` e ajuste os valores antes de subir o ambiente:
#   cp .env.example .env
#   docker compose up -d

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tech_challenge_db

# ── Segredos da aplicação ─────────────────────────────────────────────────────
# Troque em qualquer ambiente que não seja desenvolvimento local!
JWT_SECRET=tech-challenge-super-secret-key-change-in-production
WEBHOOK_SECRET=tech-challenge-webhook-secret-change-in-production

# ── Notificação por e-mail ────────────────────────────────────────────────────
# "smtp" envia para o Mailpit local (UI em http://localhost:8025);
# "log" apenas registra a notificação no log da aplicação.
NOTIFIER=smtp
EMAIL_FROM=oficina@tech-challenge.local
